# =========================================
# Tralog - 환경변수 견본 파일
# 이 파일을 복사해서 .env 로 만든 뒤 실제 값을 채워 사용하세요.
# =========================================

# --- 백엔드 API 서버 주소 ---
# 개발 환경: http://localhost:5000
# 배포 환경: https://your-api-server.com
VITE_API_BASE_URL=

# --- 네이버 지도 API (프론트엔드 지도 로드용) ---
# https://console.ncloud.com 에서 발급
VITE_NAVER_MAP_CLIENT_ID=

# --- 네이버 Geocoding API (백엔드 서버용) ---
# https://console.ncloud.com 에서 발급
NAVER_MAP_API_KEY_ID=
NAVER_MAP_API_KEY=
