# =========================================
# Tralog Server - 환경변수 견본 파일
# 이 파일을 복사해서 .env 로 만든 뒤 실제 값을 채워 사용
# =========================================

# --- 서버 포트 ---
PORT=5000

# --- MySQL 데이터베이스 ---
# 클라우드(예: Aiven) 또는 로컬(예: XAMPP) DB 정보를 채워주세요
# 스키마는 tralog_db.sql 참고
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- 네이버 지도 API (프론트엔드 지도 로드용) ---
# https://console.ncloud.com 에서 발급
VITE_NAVER_MAP_CLIENT_ID=
VITE_NAVER_MAP_CLIENT_SECRET=

# --- 네이버 검색 API (장소 검색용) ---
# https://developers.naver.com/ 에서 발급
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
